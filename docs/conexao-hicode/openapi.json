    "/v1/eventos": {
      "get": {
        "operationId": "eventos",
        "parameters": [
          {
            "name": "Last-Event-ID",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "SSE com cursor duravel. Sem cursor inicia no presente. 409 exige snapshot e reconexao. Duplicatas devem ser deduplicadas por id. Eventos pronto/reset sao de controle.",
        "responses": {
          "200": {
            "description": "Stream SSE",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Erro de autenticacao, validacao, revisao, conflito ou operacao",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    }
