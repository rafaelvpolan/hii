        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{3,12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta do motor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "plano",
                    "evidencias",
                    "atualidadeVerificada"
                  ],
                  "properties": {
                    "plano": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "evidencias": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "atualidadeVerificada": {
                      "const": false
                    }
                  }
                }
              }
            },
            "headers": {
              "ETag": {
