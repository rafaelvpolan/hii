      "post": {
        "operationId": "novaSessao",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repo": {
                    "type": "string"
                  },
                  "titulo": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "required": [
                  "repo",
                  "titulo"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resposta do motor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sessao"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
