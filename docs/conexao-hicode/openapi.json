  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Erro": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "erro": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "codigo": {
                "type": "string"
              },
              "mensagem": {
                "type": "string"
              }
            },
            "required": [
              "codigo",
              "mensagem"
            ]
          }
        },
        "required": [
          "erro"
        ]
      },
      "Capacidades": {
        "type": "object",
        "required": [
          "protocolo",
          "versao",
          "statuses",
          "acoes",
          "eventos",
          "modos"
        ],
        "properties": {
          "protocolo": {
            "const": "hii-http"
          },
          "versao": {
            "const": 1
          },
          "statuses": {
            "type": "array",
            "items": {
              "enum": [
                "INBOX",
                "READY",
                "CLARIFY",
                "SPECCED",
                "PLAN_APPROVED",
                "EXECUTING",
                "PAUSED",
                "WAITING",
                "EXECUTED",
                "URL",
                "CORRECTING",
                "URL_OK",
                "REFINED",
                "TESTS_GREEN",
                "SEC_CLEARED",
                "REVIEWED",
                "CLEANED",
                "CONFIRM",
                "PR_OPEN",
                "MERGED",
                "DEPLOYED",
                "HALTED",
                "COMPLETED"
              ]
            }
          },
          "acoes": {
            "type": "array",
            "items": {
              "enum": [
                "aprovar-plano",
                "aprovar-url",
                "recusar",
                "responder",
                "parar",
                "retomar",
                "confirmar-fecho",
                "recusar-fecho"
              ]
            }
          },
          "eventos": {
            "type": "array",
            "items": {
              "enum": [
                "tarefa_atualizada",
                "fim",
                "pausa",
                "ia_falhou",
                "ia_trocada",
                "sessao_atualizada"
              ]
            }
          },
          "modos": {
            "type": "array",
            "items": {
              "enum": [
                "gateway",
                "orquestrador"
              ]
            }
          }
        }
      },
      "Sessao": {
        "type": "object",
        "required": [
          "versao",
          "id",
          "repo",
          "titulo",
          "revisao",
          "estado",
          "mensagens",
          "execucoes",
          "subsessoes"
        ],
        "properties": {
          "versao": {
            "const": 1
          },
          "id": {
            "type": "string",
            "pattern": "^\\d{3,12}$"
          },
          "repo": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "revisao": {
            "type": "integer"
          },
          "estado": {
            "enum": [
              "aberta",
              "fechada"
            ]
          },
          "mensagens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Mensagem"
            }
          },
          "execucoes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Execucao"
            }
          },
          "subsessoes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Subsessao"
            }
          }
        }
      },
      "Mensagem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "autor": {
            "enum": [
              "humano",
              "ia"
            ]
          },
          "texto": {
            "type": "string"
          },
          "execucao": {
            "type": "string"
          },
          "provedor": {
            "type": "string"
          },
          "modelo": {
            "type": "string"
          },
          "instante": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "autor",
          "texto",
          "execucao",
          "provedor",
          "modelo",
          "instante"
        ]
      },
      "Execucao": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{3,12}$"
          },
          "modo": {
            "enum": [
              "gateway",
              "passivo"
            ]
          },
          "criadaEm": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "modo",
          "criadaEm"
        ]
      },
      "Subsessao": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "execucao": {
            "type": "string",
            "pattern": "^\\d{3,12}$"
          },
          "provedor": {
            "type": "string"
          },
          "modelo": {
            "type": "string"
          },
          "papel": {
            "type": "string"
          },
          "nativa": {
            "type": [
              "string",
              "null"
            ]
          },
          "inicio": {
            "type": "string"
          },
          "fim": {
            "type": "string"
          },
          "estado": {
            "enum": [
              "executando",
              "concluida",
              "falhou",
              "interrompida"
            ]
          }
        },
        "required": [
          "id",
          "execucao",
          "provedor",
          "modelo",
          "papel",
          "nativa",
          "inicio",
          "fim",
          "estado"
        ]
      },
      "Pedido": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "modo": {
                "enum": [
                  "gateway",
                  "orquestrador"
                ]
              },
              "texto": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
              }
            },
            "required": [
              "modo",
              "texto"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "modo": {
                "const": "orquestrador"
              },
              "spec": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "nome": {
                    "type": "string",
                    "pattern": "^[^/\\\\]+\\.spec(?:\\.md)?$",
                    "maxLength": 200
                  },
                  "conteudo": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1048576
                  }
                },
                "required": [
                  "nome",
                  "conteudo"
                ]
              }
            },
            "required": [
              "modo",
              "spec"
            ]
          }
        ],
        "description": "Limites de texto tambem aplicados em bytes UTF-8. Spec enviado por conteudo; nunca como caminho do servidor."
      },
      "PedidoCriado": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{3,12}$"
          },
          "sessao": {
            "type": "string",
            "pattern": "^\\d{3,12}$"
          },
          "modo": {
            "enum": [
              "gateway",
              "orquestrador"
            ]
          },
          "status": {
            "enum": [
              "INBOX",
              "READY",
              "CLARIFY",
              "SPECCED",
              "PLAN_APPROVED",
              "EXECUTING",
              "PAUSED",
              "WAITING",
              "EXECUTED",
              "URL",
              "CORRECTING",
              "URL_OK",
              "REFINED",
              "TESTS_GREEN",
              "SEC_CLEARED",
              "REVIEWED",
              "CLEANED",
              "CONFIRM",
              "PR_OPEN",
              "MERGED",
              "DEPLOYED",
              "HALTED",
              "COMPLETED"
            ]
          },
          "enfileirada": {
            "type": "boolean"
          },
          "mensagem": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sessao",
          "modo",
          "status",
          "enfileirada",
          "mensagem"
        ]
      },
      "Tarefa": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "etag": {
            "type": "string"
          },
          "campos": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "objetivo": {
            "type": "string"
          }
        },
        "required": [
          "etag",
          "campos",
          "objetivo"
        ]
      },
      "Estado": {
        "type": "object",
        "required": [
          "versao",
          "cursor",
          "tarefas",
          "conversas",
          "orquestrador"
        ],
        "properties": {
          "versao": {
            "const": 1
          },
          "cursor": {
            "type": "string"
          },
          "tarefas": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "conversas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sessao"
            }
          },
          "orquestrador": {
            "type": "object"
          }
        }
      },
      "Evento": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "versao": {
            "const": 1
          },
          "tipo": {
            "enum": [
              "tarefa_atualizada",
              "fim",
              "pausa",
              "ia_falhou",
              "ia_trocada",
              "sessao_atualizada"
            ]
          },
          "instante": {
            "type": "string"
          },
          "tarefa": {
            "type": "string"
          },
          "sessao": {
            "type": "string"
          },
          "dados": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "versao",
          "tipo",
          "instante",
          "tarefa",
          "sessao",
          "dados"
        ]
      },
      "Log": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "texto": {
            "type": "string"
          },
          "proximo": {
            "type": "integer",
            "minimum": 0
          },
          "reset": {
            "type": "boolean"
          }
        },
        "required": [
          "texto",
          "proximo",
          "reset"
        ]
      }
    }
  }
}
