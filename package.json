{
  "name": "hii",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "hii": "bin/hii.ts"
  },
  "scripts": {
    "runner": "bun runner.ts",
    "init": "bun runner.ts --init",
    "status": "bun runner.ts --status",
    "watch": "bun runner.ts --status --watch",
    "sync": "bun runner.ts --sync",
    "typecheck": "tsc --noEmit",
    "lint:types": "bun scripts/check-no-any.mjs",
    "lint:clone": "bun scripts/check-clone-limpo.mjs",
    "test:unit": "bun test ./test",
    "test:node": "node --test --test-timeout=60000 $(ls test/*.test.ts test/*/*.test.ts | grep -v apoio/expect-diferencial)",
    "test": "bun run typecheck && bun run lint:types && bun run lint:clone && bun run test:unit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2"
  },
  "description": "Motor de execucao autonoma: worktree, agente, gates, PR. Nao julga e nao faz merge."
}
